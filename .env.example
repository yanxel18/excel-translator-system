POSTGRES_DB=excel_translator
POSTGRES_USER=excel_translator
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_PORT=5432
API_PORT=3000
MAX_CONCURRENT_TRANSLATIONS=5
WEB_PORT=5173
PREVIEW_PORT=8081
BASE_PATH=/excel-convert
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-signing-secret
JWT_EXPIRES_IN=1h
AUTH_USERNAME=user
AUTH_PASSWORD=replace-with-a-strong-local-account-password
LOCAL_AUTH_ENABLED=true
AUTH_BOOTSTRAP_ENABLED=true
ADMIN_USERNAMES=user
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER_URL=
KEYCLOAK_URL=
KEYCLOAK_REALM=excel-translator
KEYCLOAK_CLIENT_ID=excel-translator-web
KEYCLOAK_REQUIRED_GROUP=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest
VITE_API_URL=http://localhost:3000/excel-convert
VITE_BASE_PATH=/excel-convert/

# Browser-reachable ibisOffice service; use HTTPS when the app uses HTTPS.
VITE_PREVIEW_URL=http://localhost:8081/
