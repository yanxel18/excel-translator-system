{
  "name": "excel-translator-api",
  "version": "1.0.0",
  "description": "API for Excel Translator application",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "tsc",
    "test:task4": "npm run build && node --test test/task4.test.cjs",
    "test:task5": "npm run build && node --test test/task5.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "smoke": "node verify-flow.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fast-xml-parser": "5.11.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "jwks-rsa": "^4.1.0",
    "multer": "^2.5.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/passport-local": "^1.0.38",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
