NODE_ENV=development
PORT=3000
BASE_PATH=/excel-convert
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://excel_translator:change-me@localhost:5432/excel_translator?schema=public
DATA_DIR=./data
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=1h
AUTH_USERNAME=user
AUTH_PASSWORD=change-me
LOCAL_AUTH_ENABLED=true
AUTH_BOOTSTRAP_ENABLED=false
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/excel-translator
KEYCLOAK_CLIENT_ID=excel-translator
KEYCLOAK_REQUIRED_GROUP=excel-translator-users
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
AI_API_KEY=
PREVIEW_SERVICE_URL=http://preview:8080
PREVIEW_SERVICE_TOKEN=replace-with-a-service-token
