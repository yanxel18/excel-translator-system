generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  ENGLISH
  JAPANESE
  CHINESE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum IdentityProvider {
  LOCAL
  KEYCLOAK
}

enum AuthenticationMode {
  LOCAL
  OIDC
  HYBRID
}

enum NotificationType {
  JOB_QUEUED
  JOB_PROGRESS
  JOB_COMPLETED
  JOB_FAILED
  JOB_CANCELLED
}

model User {
  id             String             @id @default(uuid())
  username       String             @unique
  email          String?            @unique
  fullName       String?
  gid            String?
  passwordHash   String?
  enabled        Boolean            @default(true)
  sessionVersion Int                @default(0)
  baseId         String?
  base           Base?              @relation(fields: [baseId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  identities     UserIdentity[]
  jobs           TranslationJob[]
  vocabulary     VocabularyGroup[]
  notifications  Notification[]
  managementAudits ManagementAudit[]

  @@index([createdAt])
  @@index([baseId])
  @@index([gid(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_gid_trgm_idx")
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_username_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

model Base {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model UserIdentity {
  id        String           @id @default(uuid())
  provider  IdentityProvider
  subject   String
  providerUsername String?
  userId    String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model OidcSettings {
  id            String   @id @default("default")
  mode          AuthenticationMode @default(LOCAL)
  enabled       Boolean  @default(false)
  keycloakUrl   String?
  realm         String?
  clientId      String?
  issuerUrl     String?
  requiredGroup String?
  updatedAt     DateTime @updatedAt
}

model ManagementAudit {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  changes    Json
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model TranslationJob {
  id                String            @id @default(uuid())
  ownerId           String
  status            JobStatus         @default(PENDING)
  fileName          String
  fileSize          Int
  mimeType          String
  sourceLanguage    Language
  targetLanguage    Language
  selectedSheets    Json
  sourcePath        String
  outputPath        String?
  vocabularyGroupId String?
  progress          Int               @default(0)
  textCount         Int?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  elapsedMs         Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vocabularyGroup   VocabularyGroup?  @relation(fields: [vocabularyGroupId], references: [id], onDelete: SetNull)
  sheets            JobSheet[]
  notifications     Notification[]

  @@index([ownerId, createdAt, id], map: "TranslationJob_ownerId_createdAt_id_idx")
  @@index([ownerId, sourceLanguage, targetLanguage, createdAt, id], map: "TranslationJob_owner_langs_created_id_idx")
  @@index([fileName(ops: raw("gin_trgm_ops"))], type: Gin, map: "TranslationJob_fileName_trgm_idx")
  @@index([ownerId, status, completedAt])
  @@index([vocabularyGroupId])
}

model JobSheet {
  id          String          @id @default(uuid())
  jobId       String
  sheetName   String
  isSelected  Boolean         @default(true)
  textCount   Int?
  job         TranslationJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sheetName])
  @@index([jobId, isSelected])
}

model VocabularyGroup {
  id             String             @id @default(uuid())
  ownerId        String
  name           String
  description    String?
  sourceLanguage Language
  targetLanguage Language
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries        VocabularyEntry[]
  jobs           TranslationJob[]

  @@unique([ownerId, name, sourceLanguage, targetLanguage])
  @@index([ownerId, sourceLanguage, targetLanguage])
}

model VocabularyEntry {
  id        String           @id @default(uuid())
  groupId   String
  source    String
  target    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  group     VocabularyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, source])
  @@index([groupId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  jobId     String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       TranslationJob?  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([jobId])
}

model ChangelogEntry {
  id          String    @id @default(uuid())
  title       String
  details     String
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}
