generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  ENGLISH
  JAPANESE
  CHINESE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum IdentityProvider {
  LOCAL
  KEYCLOAK
}

enum AuthenticationMode {
  LOCAL
  OIDC
  HYBRID
}

enum NotificationType {
  JOB_QUEUED
  JOB_PROGRESS
  JOB_COMPLETED
  JOB_FAILED
  JOB_CANCELLED
}

enum UploadSessionStatus {
  RECEIVING
  FINALIZING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

model User {
  id             String             @id @default(uuid())
  username       String             @unique
  email          String?            @unique
  /// Maximum 50 Unicode code points, enforced by User_fullName_code_points_check.
  /// Keep TEXT: the custom CHECK rejects overlong values without type-cast truncation.
  fullName       String?            @db.Text
  gid            String?
  passwordHash   String?
  enabled        Boolean            @default(true)
  sessionVersion Int                @default(0)
  baseId         String?
  base           Base?              @relation(fields: [baseId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  identities     UserIdentity[]
  jobs           TranslationJob[]
  vocabulary     VocabularyGroup[]
  notifications  Notification[]
  uploadSessions UploadSession[]
  managementAudits ManagementAudit[]

  @@index([createdAt])
  @@index([baseId])
  @@index([gid(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_gid_trgm_idx")
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_username_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

model Base {
  /// Immutable UUID compatibility key; User.baseId and existing API routes still use it.
  /// Immutability is enforced by the custom Base_id_immutable trigger.
  id        String   @unique(map: "Base_id_key") @default(uuid())
  /// Mutable factory acronym. Case-insensitive uniqueness also uses a custom index.
  code      String   @id(map: "Base_pkey")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model UserIdentity {
  id        String           @id @default(uuid())
  provider  IdentityProvider
  subject   String
  providerUsername String?
  userId    String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model OidcSettings {
  id            String   @id @default("default")
  mode          AuthenticationMode @default(LOCAL)
  enabled       Boolean  @default(false)
  keycloakUrl   String?
  realm         String?
  clientId      String?
  issuerUrl     String?
  requiredGroup String?
  updatedAt     DateTime @updatedAt
}

model ApplicationSettings {
  id                        String   @id @default("default")
  maxUploadSizeMb           Int      @default(200)
  maxConcurrentTranslations Int      @default(5)
  updatedAt                 DateTime @updatedAt
}

model UploadStorageBudget {
  id            String @id @default("default")
  /// Maintained atomically by the upload-session trigger; never a host-memory budget.
  reservedBytes Int    @default(0)
}

model UploadSession {
  id              String              @id @default(uuid()) @db.Uuid
  ownerId         String
  clientUploadId  String              @db.Uuid
  fileName        String
  fileSize        Int
  chunkHashes     String[]
  chunkSize       Int                 @default(1048576)
  bytesReceived   Int                 @default(0)
  nextChunkIndex  Int                 @default(0)
  status          UploadSessionStatus @default(RECEIVING)
  /// Retain the reservation until temporary-byte cleanup is confirmed.
  reservedBytes   Int
  /// No job FK: deleting a completed job must not erase its replay receipt.
  completionJobId String              @unique @default(uuid()) @db.Uuid
  createdAt       DateTime            @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  expiresAt       DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP + '24 hours'::interval)")) @db.Timestamptz(3)
  completedAt     DateTime?           @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  owner           User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // A custom partial unique index also covers terminal sessions awaiting cleanup.
  @@unique([ownerId, clientUploadId])
  @@index([expiresAt])
}

model MaintenanceSchedule {
  id        String    @id @default("default")
  enabled   Boolean   @default(false)
  startsAt  DateTime? @db.Timestamptz(3)
  endsAt    DateTime? @db.Timestamptz(3)
}

model ManagementAudit {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  changes    Json
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model TranslationJob {
  id                String            @id @default(uuid())
  ownerId           String
  status            JobStatus         @default(PENDING)
  fileName          String
  fileSize          Int
  mimeType          String
  sourceLanguage    Language
  targetLanguage    Language
  selectedSheets    Json
  availableSheets   Json?
  sourcePath        String
  outputPath        String?
  vocabularyGroupId String?
  progress          Int               @default(0)
  textCount         Int?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  elapsedMs         Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vocabularyGroup   VocabularyGroup?  @relation(fields: [vocabularyGroupId], references: [id], onDelete: SetNull)
  sheets            JobSheet[]
  notifications     Notification[]

  @@index([ownerId, createdAt, id], map: "TranslationJob_ownerId_createdAt_id_idx")
  @@index([ownerId, sourceLanguage, targetLanguage, createdAt, id], map: "TranslationJob_owner_langs_created_id_idx")
  @@index([fileName(ops: raw("gin_trgm_ops"))], type: Gin, map: "TranslationJob_fileName_trgm_idx")
  @@index([ownerId, status, completedAt])
  @@index([vocabularyGroupId])
}

model JobSheet {
  id          String          @id @default(uuid())
  jobId       String
  sheetName   String
  isSelected  Boolean         @default(true)
  textCount   Int?
  job         TranslationJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sheetName])
  @@index([jobId, isSelected])
}

model VocabularyGroup {
  id             String             @id @default(uuid())
  ownerId        String
  name           String
  description    String?
  sourceLanguage Language
  targetLanguage Language
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries        VocabularyEntry[]
  jobs           TranslationJob[]

  @@unique([ownerId, name, sourceLanguage, targetLanguage])
  @@index([ownerId, sourceLanguage, targetLanguage])
}

model VocabularyEntry {
  id        String           @id @default(uuid())
  groupId   String
  source    String
  target    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  group     VocabularyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, source])
  @@index([groupId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  jobId     String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       TranslationJob?  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([jobId])
}

model ChangelogEntry {
  id          String    @id @default(uuid())
  title       String
  details     String
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}
